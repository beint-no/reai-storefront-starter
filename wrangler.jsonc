{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "test-reai-storefront",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "REAI_API_BASE_URL": "https://app.reai.no"
  }
}
